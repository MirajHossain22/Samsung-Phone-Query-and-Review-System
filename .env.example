# PostgreSQL (docker compose up -d). Leave unset to use local SQLite (data/samsung.db).
DATABASE_URL=postgresql://samsung:samsung@localhost:5433/samsung

# Open-source GPT-OSS hosted by Groq through an OpenAI-compatible API.
LLM_BACKEND=openai
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b
# Other backends supported by the application: none, gemini, hf.
# For Ollama, use http://localhost:11434/v1 with API key "ollama".
# CrewAI with Ollama (install optional crewai[litellm] dependency)
# CREWAI_MODEL=ollama/qwen2.5:1.5b
# CREWAI_BASE_URL=http://localhost:11434
# --- local Hugging Face model ---
# HF_MODEL=Qwen/Qwen2.5-1.5B-Instruct
